# -- Conjuntos ------------------------------
set CHATARRA := A B;
set ELEMENTO := 1 2 3;

# -- Parámetros ------------------------------
param costo := A 100 B 80;
param composicion_minima_aleacion := 1 0.03 2 0.03 3 0.03;
param composicion_maxima_aleacion := 1 0.06 2 0.05 3 0.07;
param proporcion_elemento_chatarra:
    1 2 3 :=
  A 0.06 0.03 0.04
  B 0.03 0.06 0.03;
param toneladas_aleacion := 1000;
